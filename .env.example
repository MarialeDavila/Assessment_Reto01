# Proveedor de lenguaje: gemini | simulado (simulado no usa red ni clave)
LLM_PROVIDER=gemini
# Clave de Google AI Studio. Solo en el backend; nunca en el repositorio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Precio estimado USD por millón de tokens (para métricas de costo)
PRECIO_ENTRADA_USD_MTOK=0.75
PRECIO_SALIDA_USD_MTOK=3.75
# Topes de costo y robustez
MAX_ITERACIONES=25
MAX_TOKENS_SESION=200000
LLM_TIMEOUT_MS=60000
MENSAJES_POR_MINUTO=12
# Opcional: protege el link con una clave (cabecera x-access-key)
ACCESS_KEY=
# Opcional: fija la fecha de ejecución (YYYY-MM-DD) para evaluar vigencias de soportes
FECHA_EJECUCION=
PORT=3000
