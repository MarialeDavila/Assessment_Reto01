{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["bun"],
    "noEmit": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "demo.ts", "test", "modulo", "scripts"]
}
